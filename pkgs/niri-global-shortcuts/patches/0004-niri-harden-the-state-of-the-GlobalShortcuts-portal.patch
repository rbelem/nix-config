-fn shortcuts_value(shortcuts: &[BoundShortcut]) -> Vec<(String, HashMap<String, OwnedValue>)> {
+fn shortcuts_value(shortcuts: &[BoundShortcut]) -> ShortcutsValue {
     shortcuts
         .iter()
         .map(|shortcut| {
