+//! The compositor side of the XDG GlobalShortcuts portal.
+//!
+//! xdg-desktop-portal serves the public `org.freedesktop.portal.GlobalShortcuts`
+//! interface to applications and forwards the requests to a compositor-provided
+//! backend implementing `org.freedesktop.impl.portal.GlobalShortcuts`. This
+//! module implements that backend.
+
+use std::collections::HashMap;
+
+use niri_config::{
+    key_description, parse_shortcuts_spec_trigger, Config, Key, ModKey, Modifiers, Trigger,
+};
+use smithay::input::keyboard::xkb::keysym_to_utf8;
+use smithay::input::keyboard::{Keycode, Keysym};
+use zbus::fdo::{self, RequestNameFlags};
+use zbus::zvariant::{OwnedValue, Value};
+use zbus::{interface, zvariant};
+
+use super::Start;
+
+/// The bus name that the compositor owns for the portal backend.
+pub const BUS_NAME: &str = "org.freedesktop.impl.portal.desktop.niri";
+
+/// The object path that the portal backend serves its interface on.
+pub const OBJECT_PATH: &str = "/org/freedesktop/portal/desktop";
+
+/// The name of the portal backend interface.
+pub const INTERFACE_NAME: &str = "org.freedesktop.impl.portal.GlobalShortcuts";
+
+/// The version of the portal backend interface that niri implements.
+const INTERFACE_VERSION: u32 = 2;
+
+/// The numeric response of a successful portal request.
+const RESPONSE_SUCCESS: u32 = 0;
+
+/// A shortcut that niri bound for a portal session.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct BoundShortcut {
+    /// The session that owns the shortcut.
+    pub session: zvariant::ObjectPath<'static>,
+    /// The application-provided ID of the shortcut.
+    pub id: String,
+    /// The application-provided description of the shortcut.
+    pub description: String,
+    /// The key combination that activates the shortcut.
+    pub key: Key,
+}
+
+/// A portal session.
+#[derive(Clone, Debug)]
+struct PortalSession {
+    /// The application that created the session.
+    app_id: String,
+    /// The shortcuts currently bound for the session.
+    shortcuts: Vec<BoundShortcut>,
+}
+
+/// The compositor-side state of the GlobalShortcuts portal.
+///
+/// The state lives on the compositor's main loop. The D-Bus thread sends
+/// requests over a channel and the main loop applies them, because deciding
+/// whether a shortcut may be bound requires the binds from the user's config,
+/// which the D-Bus thread cannot read.
+#[derive(Default)]
+pub struct GlobalShortcuts {
+    /// The portal sessions, by session handle.
+    sessions: HashMap<zvariant::ObjectPath<'static>, PortalSession>,
+    /// The bound shortcuts, by key combination.
+    binds: HashMap<(Keysym, Modifiers), BoundShortcut>,
+    /// The shortcuts that are currently held down, by key code.
+    active: HashMap<Keycode, BoundShortcut>,
+    /// Used to send the portal signals.
+    emitter: Option<GlobalShortcutsEmitter>,
+}
+
+/// A request from the D-Bus thread to the compositor's main loop.
+pub enum GlobalShortcutsToNiri {
+    /// Create a session for an application.
+    CreateSession {
+        /// The session handle that the portal assigned to the session.
+        session_handle: zvariant::ObjectPath<'static>,
+        /// The application that is creating the session.
+        app_id: String,
+        /// Used to send the reply back to the D-Bus thread.
+        reply: async_channel::Sender<()>,
+    },
+    /// Bind the shortcuts of a session.
+    BindShortcuts {
+        /// The session that the shortcuts belong to.
+        session_handle: zvariant::ObjectPath<'static>,
+        /// The shortcuts that the application wants to bind.
+        shortcuts: Vec<(String, HashMap<String, OwnedValue>)>,
+        /// Used to send the reply back to the D-Bus thread.
+        reply: async_channel::Sender<Vec<BoundShortcut>>,
+    },
+    /// List the shortcuts of a session.
+    ListShortcuts {
+        /// The session to list the shortcuts of.
+        session_handle: zvariant::ObjectPath<'static>,
+        /// Used to send the reply back to the D-Bus thread.
+        reply: async_channel::Sender<Vec<BoundShortcut>>,
+    },
+    /// Re-assert the bindings of a session.
+    ConfigureShortcuts {
+        /// The session to re-assert the bindings of.
+        session_handle: zvariant::ObjectPath<'static>,
+        /// Used to send the reply back to the D-Bus thread.
+        reply: async_channel::Sender<()>,
+    },
+}
+
+impl GlobalShortcuts {
+    /// Sets the emitter used to send the portal signals.
+    pub fn set_emitter(&mut self, emitter: GlobalShortcutsEmitter) {
+        self.emitter = Some(emitter);
+    }
+
+    /// Creates a session for an application.
+    pub fn create_session(
+        &mut self,
+        session_handle: zvariant::ObjectPath<'static>,
+        app_id: String,
+    ) {
+        self.sessions.insert(
+            session_handle,
+            PortalSession {
+                app_id,
+                shortcuts: Vec::new(),
+            },
+        );
+    }
+
+    /// Binds the shortcuts of a session, replacing the session's previous set.
+    ///
+    /// Shortcuts that niri refuses to bind are left out of the result: the
+    /// portal expects the response to list only the shortcuts that are bound.
+    pub fn bind_shortcuts(
+        &mut self,
+        session_handle: &zvariant::ObjectPath<'static>,
+        shortcuts: &[(String, HashMap<String, OwnedValue>)],
+        configured_binds: &[Key],
+        mod_key: ModKey,
+    ) -> Vec<BoundShortcut> {
+        // Binding again replaces the previous set of the session.
+        self.unbind_session(session_handle);
+
+        let mut bound = Vec::new();
+        for (id, options) in shortcuts {
+            let Some((description, key)) = requested_shortcut(options) else {
+                continue;
+            };
+
+            if !is_allowed_shortcut(&key) {
+                continue;
+            }
+
+            if conflicts_with_configured_bind(configured_binds, mod_key, &key) {
+                continue;
+            }
+
+            let Trigger::Keysym(keysym) = key.trigger else {
+                continue;
+            };
+
+            // A key combination can only belong to one session.
+            if self.binds.contains_key(&(keysym, key.modifiers)) {
+                continue;
+            }
+
+            let shortcut = BoundShortcut {
+                session: session_handle.clone(),
+                id: id.clone(),
+                description,
+                key,
+            };
+            self.binds.insert((keysym, key.modifiers), shortcut.clone());
+            bound.push(shortcut);
+        }
+
+        if let Some(session) = self.sessions.get_mut(session_handle) {
+            session.shortcuts = bound.clone();
+        }
+
+        self.emit_shortcuts_changed(session_handle, &bound);
+
+        bound
+    }
+
+    /// Returns the shortcuts bound for a session.
+    pub fn list_shortcuts(
+        &self,
+        session_handle: &zvariant::ObjectPath<'static>,
+    ) -> Vec<BoundShortcut> {
+        self.sessions
+            .get(session_handle)
+            .map(|session| session.shortcuts.clone())
+            .unwrap_or_default()
+    }
+
+    /// Re-asserts the bindings of a session.
+    ///
+    /// niri has no rebinding UI, so this only re-registers the triggers that the
+    /// session already has.
+    pub fn configure_shortcuts(&mut self, session_handle: &zvariant::ObjectPath<'static>) {
+        let Some(session) = self.sessions.get(session_handle) else {
+            return;
+        };
+
+        for shortcut in &session.shortcuts {
+            let Trigger::Keysym(keysym) = shortcut.key.trigger else {
+                continue;
+            };
+
+            self.binds
+                .insert((keysym, shortcut.key.modifiers), shortcut.clone());
+            debug!("re-asserted the portal shortcut {}", shortcut.id);
+        }
+    }
+
+    /// Handles a key press or release for a portal shortcut.
+    ///
+    /// Returns true when the key press activated a shortcut. The caller must
+    /// then suppress the key, so that it doesn't reach the focused client: a
+    /// global shortcut is global.
+    pub fn handle_key(
+        &mut self,
+        key_code: Keycode,
+        keysym: Option<Keysym>,
+        modifiers: Modifiers,
+        pressed: bool,
+        timestamp_ms: u64,
+    ) -> bool {
+        if !pressed {
+            let Some(shortcut) = self.active.remove(&key_code) else {
+                return false;
+            };
+
+            self.emit_deactivated(&shortcut, timestamp_ms);
+            return false;
+        }
+
+        let Some(keysym) = keysym else {
+            return false;
+        };
+
+        let Some(shortcut) = self.binds.get(&(keysym, modifiers)).cloned() else {
+            return false;
+        };
+
+        self.active.insert(key_code, shortcut.clone());
+        self.emit_activated(&shortcut, timestamp_ms);
+
+        true
+    }
+
+    /// Removes the shortcuts of a session.
+    fn unbind_session(&mut self, session_handle: &zvariant::ObjectPath<'static>) {
+        let Some(session) = self.sessions.get_mut(session_handle) else {
+            return;
+        };
+
+        for shortcut in session.shortcuts.drain(..) {
+            let Trigger::Keysym(keysym) = shortcut.key.trigger else {
+                continue;
+            };
+
+            let key = (keysym, shortcut.key.modifiers);
+
+            // Only remove the bind if the session still owns it.
+            if self.binds.get(&key).map(|bind| &bind.session) == Some(session_handle) {
+                self.binds.remove(&key);
+            }
+        }
+    }
+
+    /// Emits the Activated signal for a shortcut.
+    fn emit_activated(&self, shortcut: &BoundShortcut, timestamp_ms: u64) {
+        trace!(
+            "portal shortcut {} of {} activated",
+            shortcut.id,
+            self.app_id(&shortcut.session),
+        );
+
+        if let Some(emitter) = &self.emitter {
+            emitter.emit_activated(shortcut, timestamp_ms);
+        }
+    }
+
+    /// Emits the Deactivated signal for a shortcut.
+    fn emit_deactivated(&self, shortcut: &BoundShortcut, timestamp_ms: u64) {
+        trace!(
+            "portal shortcut {} of {} deactivated",
+            shortcut.id,
+            self.app_id(&shortcut.session),
+        );
+
+        if let Some(emitter) = &self.emitter {
+            emitter.emit_deactivated(shortcut, timestamp_ms);
+        }
+    }
+
+    /// Returns the application that owns a session.
+    fn app_id(&self, session: &zvariant::ObjectPath<'static>) -> &str {
+        self.sessions
+            .get(session)
+            .map(|session| session.app_id.as_str())
+            .unwrap_or_default()
+    }
+
+    /// Emits the ShortcutsChanged signal for a session.
+    fn emit_shortcuts_changed(
+        &self,
+        session_handle: &zvariant::ObjectPath<'static>,
+        shortcuts: &[BoundShortcut],
+    ) {
+        if let Some(emitter) = &self.emitter {
+            emitter.emit_shortcuts_changed(session_handle, shortcuts);
+        }
+    }
+}
+
+/// Returns the description and the key combination of a requested shortcut.
+///
+/// Returns `None` when the application did not provide a usable trigger.
+fn requested_shortcut(options: &HashMap<String, OwnedValue>) -> Option<(String, Key)> {
+    let description = string_option(options, "description").unwrap_or_default();
+    let trigger = string_option(options, "preferred_trigger")?;
+    let key = parse_shortcuts_spec_trigger(&trigger)?;
+
+    Some((description, key))
+}
+
+/// Returns a string option of a shortcut, if it has one.
+fn string_option(options: &HashMap<String, OwnedValue>, name: &str) -> Option<String> {
+    match options.get(name) {
+        Some(value) => match &**value {
+            Value::Str(value) => Some(value.to_string()),
+            _ => None,
+        },
+        None => None,
+    }
+}
+
+/// Returns whether niri may bind the key combination for an application.
+///
+/// A shortcut without Ctrl, Alt or Super would steal typing from the focused
+/// client, so it is only allowed for keys that don't produce text.
+pub fn is_allowed_shortcut(key: &Key) -> bool {
+    if key
+        .modifiers
+        .intersects(Modifiers::CTRL | Modifiers::ALT | Modifiers::SUPER)
+    {
+        return true;
+    }
+
+    is_non_textual_key(key)
+}
+
+/// Returns whether the key does not insert text into the focused client.
+fn is_non_textual_key(key: &Key) -> bool {
+    let Trigger::Keysym(keysym) = key.trigger else {
+        return false;
+    };
+
+    // A keysym without a Unicode representation does not produce text. Function
+    // keys, keypad keys and media keys are all safe to bind globally.
+    keysym_to_utf8(keysym).is_empty()
+}
+
+/// Returns whether the key combination conflicts with one of the configured binds.
+///
+/// The user's own configuration always wins over an application request.
+pub fn conflicts_with_configured_bind(configured: &[Key], mod_key: ModKey, key: &Key) -> bool {
+    configured.iter().any(|configured| {
+        if configured.trigger != key.trigger {
+            return false;
+        }
+
+        let mut bind_modifiers = configured.modifiers;
+        if bind_modifiers.contains(Modifiers::COMPOSITOR) {
+            bind_modifiers |= mod_key.to_modifiers();
+        } else if bind_modifiers.contains(mod_key.to_modifiers()) {
+            bind_modifiers |= Modifiers::COMPOSITOR;
+        }
+
+        // The COMPOSITOR bit stands for the user's mod key, not for a physical
+        // modifier, so drop it before comparing with the requested shortcut.
+        bind_modifiers & !Modifiers::COMPOSITOR == key.modifiers
+    })
+}
+
+/// Returns the binds that the user configured in the config file.
+///
+/// The MRU UI binds are not included: they only exist while the UI is open,
+/// while a portal shortcut stays bound, so the shortcut must be checked
+/// against the user's persistent configuration.
+pub fn configured_binds(config: &Config) -> Vec<Key> {
+    let mut binds: Vec<Key> = config.binds.0.iter().map(|bind| bind.key).collect();
+    if config.recent_windows.on {
+        binds.extend(config.recent_windows.binds.iter().map(|bind| bind.key));
+    }
+
+    binds
+}
+
+/// Sends the portal signals on the session bus.
+pub struct GlobalShortcutsEmitter {
+    conn: zbus::blocking::Connection,
+}
+
+impl GlobalShortcutsEmitter {
+    /// Creates an emitter that sends the signals on the given connection.
+    pub fn new(conn: zbus::blocking::Connection) -> Self {
+        Self { conn }
+    }
+
+    /// Emits the Activated signal for a shortcut.
+    pub fn emit_activated(&self, shortcut: &BoundShortcut, timestamp_ms: u64) {
+        self.emit_shortcut_event("Activated", shortcut, timestamp_ms);
+    }
+
+    /// Emits the Deactivated signal for a shortcut.
+    pub fn emit_deactivated(&self, shortcut: &BoundShortcut, timestamp_ms: u64) {
+        self.emit_shortcut_event("Deactivated", shortcut, timestamp_ms);
+    }
+
+    /// Emits the ShortcutsChanged signal for a session.
+    pub fn emit_shortcuts_changed(
+        &self,
+        session_handle: &zvariant::ObjectPath<'static>,
+        shortcuts: &[BoundShortcut],
+    ) {
+        let body = (session_handle, shortcuts_value(shortcuts));
+        if let Err(err) = self.conn.emit_signal(
+            None::<&str>,
+            OBJECT_PATH,
+            INTERFACE_NAME,
+            "ShortcutsChanged",
+            &body,
+        ) {
+            warn!("error emitting the ShortcutsChanged signal: {err:?}");
+        }
+    }
+
+    /// Emits the Activated or Deactivated signal for a shortcut.
+    fn emit_shortcut_event(&self, member: &str, shortcut: &BoundShortcut, timestamp_ms: u64) {
+        let options: HashMap<String, OwnedValue> = HashMap::new();
+        let body = (
+            shortcut.session.clone(),
+            shortcut.id.clone(),
+            timestamp_ms,
+            options,
+        );
+
+        if let Err(err) =
+            self.conn
+                .emit_signal(None::<&str>, OBJECT_PATH, INTERFACE_NAME, member, &body)
+        {
+            warn!("error emitting the {member} signal: {err:?}");
+        }
+    }
+}
+
+/// Builds the portal representation of a list of shortcuts.
+fn shortcuts_value(shortcuts: &[BoundShortcut]) -> Vec<(String, HashMap<String, OwnedValue>)> {
+    shortcuts
+        .iter()
+        .map(|shortcut| {
+            let mut options = HashMap::new();
+            options.insert(
+                "description".to_string(),
+                OwnedValue::try_from(Value::from(shortcut.description.clone())).unwrap(),
+            );
+            options.insert(
+                "trigger_description".to_string(),
+                OwnedValue::try_from(Value::from(key_description(&shortcut.key))).unwrap(),
+            );
+
+            (shortcut.id.clone(), options)
+        })
+        .collect()
+}
+
+/// The D-Bus service that implements the portal backend interface.
+pub struct GlobalShortcutsService {
+    to_niri: calloop::channel::Sender<GlobalShortcutsToNiri>,
+}
+
+#[interface(name = "org.freedesktop.impl.portal.GlobalShortcuts")]
+impl GlobalShortcutsService {
+    async fn create_session(
+        &self,
+        _handle: zvariant::ObjectPath<'_>,
+        session_handle: zvariant::ObjectPath<'_>,
+        app_id: String,
+        _options: HashMap<String, OwnedValue>,
+    ) -> fdo::Result<(u32, HashMap<String, OwnedValue>)> {
+        self.request(|reply| GlobalShortcutsToNiri::CreateSession {
+            session_handle: session_handle.to_owned(),
+            app_id,
+            reply,
+        })
+        .await?;
+
+        // The portal protocol has no supported keys in the results of this call.
+        Ok((RESPONSE_SUCCESS, HashMap::new()))
+    }
+
+    async fn bind_shortcuts(
+        &self,
+        _handle: zvariant::ObjectPath<'_>,
+        session_handle: zvariant::ObjectPath<'_>,
+        shortcuts: Vec<(String, HashMap<String, OwnedValue>)>,
+        _parent_window: String,
+        _options: HashMap<String, OwnedValue>,
+    ) -> fdo::Result<(u32, HashMap<String, OwnedValue>)> {
+        let bound = self
+            .request(|reply| GlobalShortcutsToNiri::BindShortcuts {
+                session_handle: session_handle.to_owned(),
+                shortcuts,
+                reply,
+            })
+            .await?;
+
+        let mut results = HashMap::new();
+        results.insert(
+            "shortcuts".to_string(),
+            OwnedValue::try_from(Value::from(shortcuts_value(&bound))).unwrap(),
+        );
+
+        Ok((RESPONSE_SUCCESS, results))
+    }
+
+    async fn list_shortcuts(
+        &self,
+        _handle: zvariant::ObjectPath<'_>,
+        session_handle: zvariant::ObjectPath<'_>,
+    ) -> fdo::Result<(u32, HashMap<String, OwnedValue>)> {
+        let bound = self
+            .request(|reply| GlobalShortcutsToNiri::ListShortcuts {
+                session_handle: session_handle.to_owned(),
+                reply,
+            })
+            .await?;
+
+        let mut results = HashMap::new();
+        results.insert(
+            "shortcuts".to_string(),
+            OwnedValue::try_from(Value::from(shortcuts_value(&bound))).unwrap(),
+        );
+
+        Ok((RESPONSE_SUCCESS, results))
+    }
+
+    async fn configure_shortcuts(
+        &self,
+        session_handle: zvariant::ObjectPath<'_>,
+        _parent_window: String,
+        _options: HashMap<String, OwnedValue>,
+    ) -> fdo::Result<()> {
+        self.request(|reply| GlobalShortcutsToNiri::ConfigureShortcuts {
+            session_handle: session_handle.to_owned(),
+            reply,
+        })
+        .await?;
+
+        Ok(())
+    }
+
+    #[zbus(name = "version", property)]
+    fn version(&self) -> u32 {
+        INTERFACE_VERSION
+    }
+
+    #[zbus(signal)]
+    pub async fn activated(
+        ctxt: &zbus::object_server::SignalEmitter<'_>,
+        session_handle: zvariant::ObjectPath<'_>,
+        shortcut_id: String,
+        timestamp: u64,
+        options: HashMap<String, OwnedValue>,
+    ) -> zbus::Result<()>;
+
+    #[zbus(signal)]
+    pub async fn deactivated(
+        ctxt: &zbus::object_server::SignalEmitter<'_>,
+        session_handle: zvariant::ObjectPath<'_>,
+        shortcut_id: String,
+        timestamp: u64,
+        options: HashMap<String, OwnedValue>,
+    ) -> zbus::Result<()>;
+
+    #[zbus(signal)]
+    pub async fn shortcuts_changed(
+        ctxt: &zbus::object_server::SignalEmitter<'_>,
+        session_handle: zvariant::ObjectPath<'_>,
+        shortcuts: Vec<(String, HashMap<String, OwnedValue>)>,
+    ) -> zbus::Result<()>;
+}
+
+impl GlobalShortcutsService {
+    /// Creates the service.
+    pub fn new(to_niri: calloop::channel::Sender<GlobalShortcutsToNiri>) -> Self {
+        Self { to_niri }
+    }
+
+    /// Sends a request to the compositor's main loop and waits for the reply.
+    async fn request<T>(
+        &self,
+        request: impl FnOnce(async_channel::Sender<T>) -> GlobalShortcutsToNiri,
+    ) -> fdo::Result<T> {
+        let (reply, receiver) = async_channel::bounded(1);
+        if let Err(err) = self.to_niri.send(request(reply)) {
+            warn!("error sending message to niri: {err:?}");
+            return Err(fdo::Error::Failed("internal error".to_owned()));
+        }
+
+        receiver.recv().await.map_err(|err| {
+            warn!("error receiving message from niri: {err:?}");
+            fdo::Error::Failed("internal error".to_owned())
+        })
+    }
+}
+
+impl Start for GlobalShortcutsService {
+    fn start(self) -> anyhow::Result<zbus::blocking::Connection> {
+        let conn = zbus::blocking::Connection::session()?;
+        let flags = RequestNameFlags::AllowReplacement
+            | RequestNameFlags::ReplaceExisting
+            | RequestNameFlags::DoNotQueue;
+
+        conn.object_server().at(OBJECT_PATH, self)?;
+        conn.request_name_with_flags(BUS_NAME, flags)?;
+
+        Ok(conn)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    use std::process::Command;
+    use std::sync::{Arc, Mutex};
+
+    use niri_config::Trigger;
+    use smithay::input::keyboard::Keysym;
+
+    /// Builds the options map of a requested shortcut.
+    fn shortcut_options(description: &str, trigger: &str) -> HashMap<String, OwnedValue> {
+        let mut options = HashMap::new();
+        options.insert(
+            "description".to_string(),
+            OwnedValue::try_from(Value::from(description.to_owned())).unwrap(),
+        );
+        options.insert(
+            "preferred_trigger".to_string(),
+            OwnedValue::try_from(Value::from(trigger.to_owned())).unwrap(),
+        );
+
+        options
+    }
+
+    /// Creates an object path for the tests.
+    fn object_path(path: &str) -> zvariant::ObjectPath<'static> {
+        zvariant::ObjectPath::try_from(path.to_owned()).unwrap()
+    }
+
+    #[test]
+    fn session_bookkeeping() {
+        let mut state = GlobalShortcuts::default();
+        let session = object_path("/org/freedesktop/portal/desktop/session/1");
+
+        state.create_session(session.clone(), "org.example.App".to_owned());
+        assert!(state.list_shortcuts(&session).is_empty());
+
+        let bound = state.bind_shortcuts(
+            &session,
+            &[(
+                "shortcut".to_owned(),
+                shortcut_options("Do the thing", "CTRL+ALT+T"),
+            )],
+            &[],
+            ModKey::Super,
+        );
+        assert_eq!(bound.len(), 1);
+        assert_eq!(bound[0].id, "shortcut");
+        assert_eq!(bound[0].description, "Do the thing");
+        assert_eq!(bound[0].key.trigger, Trigger::Keysym(Keysym::t));
+        assert_eq!(bound[0].key.modifiers, Modifiers::CTRL | Modifiers::ALT);
+        assert_eq!(state.list_shortcuts(&session), bound);
+
+        // Binding again replaces the previous set of the session.
+        let bound = state.bind_shortcuts(
+            &session,
+            &[(
+                "other".to_owned(),
+                shortcut_options("Do another thing", "CTRL+SHIFT+a"),
+            )],
+            &[],
+            ModKey::Super,
+        );
+        assert_eq!(bound.len(), 1);
+        assert_eq!(bound[0].id, "other");
+        assert_eq!(state.list_shortcuts(&session), bound);
+    }
+
+    #[test]
+    fn binding_policy() {
+        // A bare letter would steal typing from the focused client.
+        assert!(!is_allowed_shortcut(&Key {
+            trigger: Trigger::Keysym(Keysym::t),
+            modifiers: Modifiers::empty(),
+        }));
+        // A function key does not produce text, so it is safe to bind.
+        assert!(is_allowed_shortcut(&Key {
+            trigger: Trigger::Keysym(Keysym::F8),
+            modifiers: Modifiers::empty(),
+        }));
+        // With a modifier, a letter is fine.
+        assert!(is_allowed_shortcut(&Key {
+            trigger: Trigger::Keysym(Keysym::t),
+            modifiers: Modifiers::CTRL,
+        }));
+        // A shortcut without a usable trigger is not bound at all.
+        let mut state = GlobalShortcuts::default();
+        let session = object_path("/org/freedesktop/portal/desktop/session/2");
+        state.create_session(session.clone(), "org.example.App".to_owned());
+        let bound = state.bind_shortcuts(
+            &session,
+            &[(
+                "broken".to_owned(),
+                shortcut_options("Broken", "CTRL+NotAKey"),
+            )],
+            &[],
+            ModKey::Super,
+        );
+        assert!(bound.is_empty());
+    }
+
+    #[test]
+    fn configured_binds_win() {
+        let configured = vec![Key {
+            trigger: Trigger::Keysym(Keysym::t),
+            modifiers: Modifiers::CTRL,
+        }];
+
+        assert!(conflicts_with_configured_bind(
+            &configured,
+            ModKey::Super,
+            &Key {
+                trigger: Trigger::Keysym(Keysym::t),
+                modifiers: Modifiers::CTRL,
+            },
+        ));
+        assert!(!conflicts_with_configured_bind(
+            &configured,
+            ModKey::Super,
+            &Key {
+                trigger: Trigger::Keysym(Keysym::t),
+                modifiers: Modifiers::CTRL | Modifiers::ALT,
+            },
+        ));
+
+        // A bind that uses the user's mod key conflicts with the same
+        // combination written out explicitly.
+        let configured = vec![Key {
+            trigger: Trigger::Keysym(Keysym::t),
+            modifiers: Modifiers::COMPOSITOR,
+        }];
+        assert!(conflicts_with_configured_bind(
+            &configured,
+            ModKey::Super,
+            &Key {
+                trigger: Trigger::Keysym(Keysym::t),
+                modifiers: Modifiers::SUPER,
+            },
+        ));
+    }
+
+    /// A private D-Bus daemon for the test.
+    struct TestBus {
+        address: String,
+        pid: u32,
+    }
+
+    impl TestBus {
+        fn start() -> Option<Self> {
+            let output = Command::new("dbus-daemon")
+                .args(["--session", "--print-address", "--print-pid", "--fork"])
+                .output()
+                .ok()?;
+            let stdout = String::from_utf8(output.stdout).ok()?;
+            let mut lines = stdout.lines();
+            let address = lines.next()?.to_owned();
+            let pid = lines.next()?.parse().ok()?;
+
+            Some(Self { address, pid })
+        }
+    }
+
+    impl Drop for TestBus {
+        fn drop(&mut self) {
+            unsafe {
+                libc::kill(self.pid as libc::pid_t, libc::SIGTERM);
+            }
+        }
+    }
+
+    /// Handles the portal requests the way the compositor's main loop does.
+    fn handle_requests(
+        receiver: calloop::channel::Channel<GlobalShortcutsToNiri>,
+        state: Arc<Mutex<GlobalShortcuts>>,
+    ) {
+        while let Ok(msg) = receiver.recv() {
+            match msg {
+                GlobalShortcutsToNiri::CreateSession {
+                    session_handle,
+                    app_id,
+                    reply,
+                } => {
+                    state.lock().unwrap().create_session(session_handle, app_id);
+                    let _ = reply.try_send(());
+                }
+                GlobalShortcutsToNiri::BindShortcuts {
+                    session_handle,
+                    shortcuts,
+                    reply,
+                } => {
+                    let bound = state.lock().unwrap().bind_shortcuts(
+                        &session_handle,
+                        &shortcuts,
+                        &[],
+                        ModKey::Super,
+                    );
+                    let _ = reply.try_send(bound);
+                }
+                GlobalShortcutsToNiri::ListShortcuts {
+                    session_handle,
+                    reply,
+                } => {
+                    let bound = state.lock().unwrap().list_shortcuts(&session_handle);
+                    let _ = reply.try_send(bound);
+                }
+                GlobalShortcutsToNiri::ConfigureShortcuts {
+                    session_handle,
+                    reply,
+                } => {
+                    state.lock().unwrap().configure_shortcuts(&session_handle);
+                    let _ = reply.try_send(());
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn dbus_round_trip() {
+        let Some(bus) = TestBus::start() else {
+            eprintln!("skipping the D-Bus test: dbus-daemon is not available");
+            return;
+        };
+
+        let (to_niri, from_niri) = calloop::channel::channel();
+        let state = Arc::new(Mutex::new(GlobalShortcuts::default()));
+        let thread_state = state.clone();
+        std::thread::spawn(move || handle_requests(from_niri, thread_state));
+
+        let service = GlobalShortcutsService::new(to_niri);
+        let conn = zbus::blocking::connection::Builder::address(bus.address.as_str())
+            .unwrap()
+            .serve_at(OBJECT_PATH, service)
+            .unwrap()
+            .name(BUS_NAME)
+            .unwrap()
+            .build()
+            .unwrap();
+
+        let client = zbus::blocking::connection::Builder::address(bus.address.as_str())
+            .unwrap()
+            .build()
+            .unwrap();
+
+        let session = object_path("/org/freedesktop/portal/desktop/session/1");
+        let request = object_path("/org/freedesktop/portal/desktop/request/1");
+
+        let reply = client
+            .call_method(
+                Some(BUS_NAME),
+                OBJECT_PATH,
+                Some(INTERFACE_NAME),
+                "CreateSession",
+                &(
+                    request.clone(),
+                    session.clone(),
+                    "org.example.App".to_owned(),
+                    HashMap::<String, OwnedValue>::new(),
+                ),
+            )
+            .unwrap();
+        let (response, _results): (u32, HashMap<String, OwnedValue>) =
+            reply.body().deserialize().unwrap();
+        assert_eq!(response, RESPONSE_SUCCESS);
+
+        let reply = client
+            .call_method(
+                Some(BUS_NAME),
+                OBJECT_PATH,
+                Some(INTERFACE_NAME),
+                "BindShortcuts",
+                &(
+                    request.clone(),
+                    session.clone(),
+                    vec![(
+                        "shortcut".to_owned(),
+                        shortcut_options("Do the thing", "CTRL+ALT+T"),
+                    )],
+                    String::new(),
+                    HashMap::<String, OwnedValue>::new(),
+                ),
+            )
+            .unwrap();
+        let (response, results): (u32, HashMap<String, OwnedValue>) =
+            reply.body().deserialize().unwrap();
+        assert_eq!(response, RESPONSE_SUCCESS);
+        assert!(results.contains_key("shortcuts"));
+
+        let reply = client
+            .call_method(
+                Some(BUS_NAME),
+                OBJECT_PATH,
+                Some(INTERFACE_NAME),
+                "ListShortcuts",
+                &(request.clone(), session.clone()),
+            )
+            .unwrap();
+        let (response, results): (u32, HashMap<String, OwnedValue>) =
+            reply.body().deserialize().unwrap();
+        assert_eq!(response, RESPONSE_SUCCESS);
+        assert!(results.contains_key("shortcuts"));
+
+        let reply = client
+            .call_method(
+                Some(BUS_NAME),
+                OBJECT_PATH,
+                Some(INTERFACE_NAME),
+                "ConfigureShortcuts",
+                &(
+                    session.clone(),
+                    String::new(),
+                    HashMap::<String, OwnedValue>::new(),
+                ),
+            )
+            .unwrap();
+        let _: () = reply.body().deserialize().unwrap();
+
+        // The property of the interface.
+        let reply = client
+            .call_method(
+                Some(BUS_NAME),
+                OBJECT_PATH,
+                Some("org.freedesktop.DBus.Properties"),
+                "Get",
+                &(INTERFACE_NAME.to_owned(), "version".to_owned()),
+            )
+            .unwrap();
+        let version: zvariant::OwnedValue = reply.body().deserialize().unwrap();
+        assert_eq!(
+            version
+                .downcast_ref::<u32>()
+                .map_err(|err| err.to_string())
+                .unwrap(),
+            INTERFACE_VERSION,
+        );
+
+        drop(conn);
+    }
+}
