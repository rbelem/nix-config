# Generates the Hyprland configuration for the Omarchy desktop.
#
# The session wrapper passes it to Hyprland with --config, so the file is
# reproducible and reviewable. It is the whole configuration: there is no
# include of a user file, because Hyprland's `source` errors on a missing
# path and a fresh account has nothing to include.
{ lib, bindings, theme }:

let
  # Hyprland spells the modifiers in capitals and puts the key in a field of
  # its own, so "Super+Shift+1" becomes "SUPER SHIFT, 1" and a key without
  # modifiers keeps the empty field.
  modifierNames = {
    Super = "SUPER";
    Shift = "SHIFT";
    Ctrl = "CTRL";
    Alt = "ALT";
  };

  bindKey = key:
    let
      parts = lib.splitString "+" key;
      modifiers = lib.concatStringsSep " " (map (name: modifierNames.${name}) (lib.init parts));
    in
    "${modifiers}, ${lib.last parts}";

  # The theme's colours carry the '#' that Hyprland's rgba() does not take.
  rgba = colour: "rgba(${lib.removePrefix "#" colour}ee)";

  bindLine = bind: ''
    # ${bind.title or bind.action}
    bind${bind.props or ""} = ${bindKey bind.key}, ${bind.action}
  '';
in
''
  # Generated by the NixOS module nixos/desktop/omarchy.
  # Edit the module options, not this file.

  general {
      gaps_in = 4
      gaps_out = 8
      border_size = 2
      col.active_border = ${rgba theme.accent}
      col.inactive_border = ${rgba theme.muted}

      # niri's layout: one column of windows per workspace, the columns scroll
      # sideways instead of shrinking to fit another one.
      layout = scrolling
  }

  scrolling {
      column_width = 0.5
      direction = right
      follow_focus = true
  }

  input {
      kb_layout = us
  }

  # Start the session services directly. Starting graphical-session.target
  # is not enough: the target stays active across SDDM logouts on a machine
  # that never rebooted, and starting an active target starts nothing, so
  # the wallpaper, theme, polkit, notification and idle services would never
  # run. Starting each unit is idempotent in both cases.
  exec-once = systemctl --user start omarchy-wallpaper.service omarchy-theme.service omarchy-gtk.service omarchy-polkit-agent.service omarchy-notifications.service omarchy-idle.service

  ${lib.concatMapStrings bindLine bindings}
''
