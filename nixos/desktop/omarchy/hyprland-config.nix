# Generates the Hyprland configuration for the Omarchy desktop.
#
# The session wrapper passes it to Hyprland with --config, so the file is
# reproducible and reviewable. It is the whole configuration: there is no
# include of a user file, because Hyprland's `source` errors on a missing
# path and a fresh account has nothing to include.
#
# Hyprland 0.56 speaks Lua. Every classic dispatcher from bindings.nix maps
# to its hl.dsp.* equivalent in dispatcherOf, checked against the 0.56
# Dispatchers reference; an action with no equivalent throws instead of
# emitting a guess.
{ lib, bindings, theme }:

let
  # Hyprland spells the modifiers in capitals and joins them upstream-style,
  # so "Super+Shift+1" becomes "SUPER + SHIFT + 1". A key without modifiers
  # (the XF86 media keys) keeps its bare name.
  modifierNames = {
    Super = "SUPER";
    Shift = "SHIFT";
    Ctrl = "CTRL";
    Alt = "ALT";
  };

  luaKey = key:
    let
      parts = lib.splitString "+" key;
      modifiers = map
        (name: modifierNames.${name} or (throw "hyprland-config.nix: unknown modifier '${name}' in key '${key}'"))
        (lib.init parts);
    in
    lib.concatStringsSep " + " (modifiers ++ [ (lib.last parts) ]);

  # The theme's colours carry the '#' that Hyprland's rgba() does not take.
  rgba = colour: "rgba(${lib.removePrefix "#" colour}ee)";

  # A Lua double-quoted string. JSON string syntax is valid Lua here.
  luaString = builtins.toJSON;

  # A directional monitor move resolves its monitor at press time, the way
  # upstream's o.workspaces helpers do: with no monitor in that direction
  # the bind is a no-op instead of an on-screen error.
  monitorFunction = dispatch: direction:
    "(function()\n"
    + "  local target = hl.get_monitor(${luaString direction})\n"
    + "  if target then\n"
    + "    ${dispatch}\n"
    + "  end\n"
    + "end)";

  dispatcherOf = action:
    let
      parts = lib.splitString "," action;
      name = lib.head parts;
      arg = lib.concatStringsSep "," (lib.tail parts);
    in
    if name == "exec" then
      "hl.dsp.exec_cmd(${luaString arg})"
    else if name == "killactive" then
      "hl.dsp.window.close()"
    else if name == "togglefloating" then
      "hl.dsp.window.float({ action = \"toggle\" })"
    else if name == "fullscreen" && arg == "0" then
      "hl.dsp.window.fullscreen({ mode = \"fullscreen\" })"
    else if name == "fullscreen" && arg == "1" then
      "hl.dsp.window.fullscreen({ mode = \"maximized\" })"
    else if name == "layoutmsg" then
      "hl.dsp.layout(${luaString arg})"
    else if name == "movefocus" then
      "hl.dsp.focus({ direction = ${luaString arg} })"
    else if name == "focuscurrentorlast" then
      "hl.dsp.focus({ last = true })"
    else if name == "focusmonitor" then
      "hl.dsp.focus({ monitor = ${luaString arg} })"
    else if name == "movewindow" && lib.hasPrefix "mon:" arg then
      monitorFunction
        "hl.dispatch(hl.dsp.window.move({ monitor = target.name, follow = true }))"
        (lib.removePrefix "mon:" arg)
    else if name == "movewindow" then
      "hl.dsp.window.move({ direction = ${luaString arg} })"
    else if name == "swapwindow" then
      "hl.dsp.window.swap({ direction = ${luaString arg} })"
    else if name == "workspace" then
      "hl.dsp.focus({ workspace = ${luaString arg} })"
    else if name == "movetoworkspace" then
      "hl.dsp.window.move({ workspace = ${luaString arg}, follow = true })"
    else if name == "movecurrentworkspacetomonitor" then
      monitorFunction
        "hl.dispatch(hl.dsp.workspace.move({ monitor = target.name }))"
        arg
    else
      throw "hyprland-config.nix: no hl.dsp equivalent for dispatcher '${action}'";

  bindLine = bind:
    let
      flags = lib.concatStringsSep ", "
        ([ "description = ${luaString bind.title}" ]
          ++ lib.optional (bind.props or "" == "l") "locked = true");
    in
    ''
      -- ${bind.title}
      hl.bind(${luaString (luaKey bind.key)}, ${dispatcherOf bind.action}, { ${flags} })
    '';
in
''
  -- Generated by the NixOS module nixos/desktop/omarchy.
  -- Edit the module options, not this file.

  hl.config({
    general = {
      gaps_in = 4,
      gaps_out = 8,
      border_size = 2,
      col = {
        active_border = ${luaString (rgba theme.accent)},
        inactive_border = ${luaString (rgba theme.muted)},
      },

      -- niri's layout: one column of windows per workspace, the columns scroll
      -- sideways instead of shrinking to fit another one.
      layout = "scrolling",
    },

    scrolling = {
      column_width = 0.5,
      direction = "right",
      follow_focus = true,
    },

    input = {
      kb_layout = "us",
    },
  })

  -- Start the session services directly. Starting graphical-session.target
  -- is not enough: the target stays active across SDDM logouts on a machine
  -- that never rebooted, and starting an active target starts nothing, so
  -- the wallpaper, theme, polkit and idle services would never run. Starting
  -- each unit is idempotent in both cases.
  -- The shell starts with the compositor, upstream's autostart.lua form: no
  -- systemd unit, because the shell must not outlive the compositor.
  hl.on("hyprland.start", function()
    hl.exec_cmd("systemctl --user start omarchy-wallpaper.service omarchy-theme.service omarchy-gtk.service omarchy-polkit-agent.service omarchy-idle.service")
    hl.exec_cmd("omarchy-launch-shell")
  end)

  ${lib.concatMapStringsSep "\n" bindLine bindings}
''
