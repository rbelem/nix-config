# Generates the niri configuration for the Omarchy desktop.
#
# The file is written to the Nix store and passed to niri with --config, so it
# is reproducible and reviewable. User overrides live in
# ~/.config/niri/overrides.kdl and are included last.
{ lib, bindings, theme }:

let
  bindLine = b:
    "    ${b.key}"
    + (if b.props or "" != "" then " ${b.props}" else "")
    + " hotkey-overlay-title=\"${b.title or b.action}\""
    + " { ${b.action}; }\n";
in
''
  // Generated by the NixOS module nixos/desktop/omarchy.
  // Edit the module options, not this file.

  layout {
      background-color "${theme.dark_background}";
      gaps 8;

      focus-ring {
          width 2;
          active-color "${theme.accent}";
          inactive-color "${theme.muted}";
      }
  }

  binds {
  ${lib.concatMapStrings bindLine bindings}  }

  // Local overrides, applied last. Optional so a fresh account still starts.
  include optional=true "~/.config/niri/overrides.kdl"
''
